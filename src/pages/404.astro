---
import "@fontsource/cormorant-garamond/400.css";
import "@fontsource/cormorant-garamond/600.css";
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Seite nicht gefunden | Lara 47</title>
    <style>
      :root { color-scheme: dark; font-family: Georgia, serif; background: #0b0a08; color: #f3ede2; }
      body { min-height: 100vh; margin: 0; display: grid; place-items: center; text-align: center; padding: 1.5rem; }
      main { max-width: 38rem; }
      p:first-child { margin: 0; color: #b89156; font: 600 clamp(7rem, 28vw, 14rem)/.75 "Cormorant Garamond", Georgia, serif; }
      h1 { font: 600 clamp(2.2rem, 8vw, 4.5rem)/.95 "Cormorant Garamond", Georgia, serif; }
      a { display: inline-flex; min-height: 2.75rem; align-items: center; padding: 0 1.25rem; color: #0b0a08; background: #b89156; text-decoration: none; }
      a:focus-visible { outline: 3px solid #f3ede2; outline-offset: 4px; }
    </style>
  </head>
  <body>
    <main>
      <p aria-hidden="true">47</p>
      <h1>Diese Seite bleibt verschlossen.</h1>
      <p>Die gesuchte Adresse gibt es nicht.</p>
      <a href="/">Zurück zu Lara 47</a>
    </main>
  </body>
</html>
