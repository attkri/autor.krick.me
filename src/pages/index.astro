---
import { Image } from "astro:assets";
import "@fontsource/cormorant-garamond/400.css";
import "@fontsource/cormorant-garamond/400-italic.css";
import "@fontsource/cormorant-garamond/600.css";

import authorPortrait from "../assets/attila-krick.png";
import bookCover from "../assets/lara47-cover.jpg";
import heroBanner from "../assets/lara47-banner.png";
import twoCups from "../assets/zwei-tassen.png";

const amazonUrl = "https://www.amazon.de/dp/B0GXXH1NCV";
const spotifyUrl = "https://open.spotify.com/artist/7xHFjmvtJp2sSOBuRqKjiy";
const youtubeUrl = "https://www.youtube.com/@AttilaKrickAutor";
const trailerUrl = "https://youtu.be/e9Bvkmb1Cwo";
const instagramUrl = "https://www.instagram.com/a_tti_la/";

const externalProps = {
  target: "_blank",
  rel: "noopener noreferrer",
};

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Book",
      name: "Lara 47 - Zwischen Kontrolle und Hingabe",
      author: { "@type": "Person", name: "Attila Krick" },
      inLanguage: "de",
      genre: "Dark Romance",
      isbn: ["9798258989864", "9798197115027"],
      url: "https://autor.krick.me/",
      offers: { "@type": "Offer", url: amazonUrl, availability: "https://schema.org/InStock" },
    },
    {
      "@type": "Person",
      name: "Attila Krick",
      url: "https://autor.krick.me/",
      sameAs: [instagramUrl, spotifyUrl, youtubeUrl],
    },
  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0b0a08" />
    <meta name="color-scheme" content="dark" />
    <meta
      name="description"
      content="Lara 47 von Attila Krick: Dark Romance über Macht, Trauma, Vertrauen und den Preis von Hingabe. Buch, Musik und Trailer."
    />
    <meta property="og:type" content="book" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Attila Krick" />
    <meta property="og:title" content="Lara 47 - Zwischen Kontrolle und Hingabe" />
    <meta
      property="og:description"
      content="Er kauft sie. Und genau deshalb darf er sie nicht besitzen."
    />
    <meta property="og:url" content="https://autor.krick.me/" />
    <meta property="og:image" content="https://autor.krick.me/og-lara47.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Lara 47 von Attila Krick" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href="https://autor.krick.me/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Lara 47 | Attila Krick</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>

    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="Lara 47, Startseite">
        <span>Lara</span><strong>47</strong>
      </a>
      <nav aria-label="Hauptnavigation">
        <a href="#buch">Buch</a>
        <a href="/leseprobe/">Leseprobe</a>
        <a href="#musik">Musik</a>
        <a href="#autor">Autor</a>
        <a href="#impressum">Impressum</a>
      </nav>
    </header>

    <main id="inhalt">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <Image
          class="hero-image"
          src={heroBanner}
          alt="Lara steht mit der Lotnummer 47 im Nacken unter einem Lichtkegel auf einer dunklen Bühne."
          widths={[960, 1440, 2033]}
          sizes="100vw"
          format="avif"
          quality={72}
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero-scrim"></div>
        <div class="hero-index" aria-hidden="true">47</div>
        <div class="hero-copy">
          <p class="eyebrow"><span>Roman</span><span>Dark Romance</span><span>Ab 18</span></p>
          <h1 id="hero-title">Lara <em>47</em></h1>
          <p class="subtitle">Zwischen Kontrolle und Hingabe</p>
          <p class="hero-lead">Er kauft sie. Und genau deshalb darf er sie nicht besitzen.</p>
          <div class="actions">
            <a class="button button-primary" href={amazonUrl} {...externalProps}>
              Bei Amazon ansehen <span aria-hidden="true">↗</span>
            </a>
            <a class="button button-secondary" href={trailerUrl} {...externalProps}>
              Trailer ansehen <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>

      <section class="book section" id="buch" aria-labelledby="book-title">
        <div class="section-marker" aria-hidden="true"><span>01</span><span>Buch</span></div>
        <div class="cover-stage">
          <span class="cover-number" aria-hidden="true">47</span>
          <Image
            class="book-cover"
            src={bookCover}
            alt="Buchcover von Lara 47 - Zwischen Kontrolle und Hingabe"
            widths={[360, 560, 760]}
            sizes="(max-width: 760px) 70vw, 34vw"
            format="avif"
            quality={82}
          />
        </div>
        <div class="book-copy">
          <p class="overline">Lara 47</p>
          <h2 id="book-title">Sie hat gelernt zu funktionieren. Leben muss sie erst wieder.</h2>
          <p>
            Mateo ersteigert Lara als Lot 47. Was er ihr anbietet, ist kein einfacher Ausweg,
            sondern ein gefährlicher Pakt. Während Vera die alten Netze enger zieht, muss Lara
            herausfinden, was sie selbst will und was Freiheit für sie kostet.
          </p>
          <p>
            Eine Dark Romance über Macht, Trauma, Vertrauen und den Preis von Hingabe. Düster,
            sinnlich und spannungsgetrieben.
          </p>
          <dl class="book-data">
            <div><dt>Formate</dt><dd>Kindle, Taschenbuch, Hardcover</dd></div>
            <div><dt>Kindle Unlimited</dt><dd>Aktuell im Abonnement enthalten</dd></div>
            <div><dt>Taschenbuch</dt><dd>ISBN 9798258989864</dd></div>
            <div><dt>Hardcover</dt><dd>ISBN 9798197115027</dd></div>
          </dl>
          <div class="book-links">
            <a class="button button-primary" href="/leseprobe/">Kapitel 1 lesen</a>
            <a class="amazon-badge" href={amazonUrl} {...externalProps}>
              <img src="/available-at-amazon-de.png" alt="Erhältlich bei Amazon" width="340" height="165" />
            </a>
          </div>
          <details class="content-note">
            <summary>Inhaltshinweis</summary>
            <p>
              Der Roman richtet sich an Erwachsene. Er behandelt unter anderem Menschenhandel,
              Gefangenschaft, Konditionierung, Gewalt, Trauma, Machtgefälle und explizite Sexualität.
            </p>
          </details>
        </div>
      </section>

      <section class="manifesto" aria-label="Kernsatz des Romans">
        <p>Freiheit darf nicht aussehen<br />wie ein schöneres Gefängnis.</p>
        <span aria-hidden="true">47</span>
      </section>

      <section class="music section" id="musik" aria-labelledby="music-title">
        <div class="section-marker" aria-hidden="true"><span>02</span><span>Musik</span></div>
        <div class="music-visual">
          <Image
            src={twoCups}
            alt="Zwei Tassen stehen auf einem Holztisch vor einem Fenster mit Blick auf das Meer."
            widths={[640, 960, 1400]}
            sizes="(max-width: 800px) 100vw, 56vw"
            format="avif"
            quality={76}
          />
          <p class="image-caption">Manche Kapitel enden nicht auf der letzten Seite.</p>
        </div>
        <div class="music-copy">
          <p class="overline">Lara 47 hören</p>
          <h2 id="music-title">Songs aus derselben Welt.</h2>
          <p>
            Die Musik nimmt Figuren, Kapitel und Spannungen des Romans auf. Attila Krick veröffentlicht
            Buchsongs auf Spotify und YouTube. Der offizielle Trailer führt zuerst in Laras Welt.
          </p>
          <div class="media-links">
            <a href={spotifyUrl} {...externalProps}>
              <span class="media-count">01</span>
              <span><strong>Spotify</strong><small>Buchsongs von Attila Krick</small></span>
              <span aria-hidden="true">↗</span>
            </a>
            <a href={youtubeUrl} {...externalProps}>
              <span class="media-count">02</span>
              <span><strong>YouTube</strong><small>Trailer, Songs und Einblicke</small></span>
              <span aria-hidden="true">↗</span>
            </a>
            <a href={trailerUrl} {...externalProps}>
              <span class="media-count">03</span>
              <span><strong>Offizieller Trailer</strong><small>Lara 47 auf YouTube</small></span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
          <p class="privacy-note">Die Plattformen werden erst geöffnet, wenn du einen Link auswählst.</p>
        </div>
      </section>

      <section class="author section" id="autor" aria-labelledby="author-title">
        <div class="section-marker" aria-hidden="true"><span>03</span><span>Autor</span></div>
        <div class="author-copy">
          <p class="overline">Attila Krick</p>
          <h2 id="author-title">Mich interessieren Figuren, die nicht rund laufen.</h2>
          <p>
            In meinem Zeugnis der ersten Klasse stand, dass mir das Wiedergeben von Geschichten
            schwerfällt. Heute schreibe ich Dark Romance über Macht, Nähe, Verletzlichkeit und
            Widerstand.
          </p>
          <p>
            Dazwischen lagen ein Sozialberuf und die Bundeswehr. Seit vielen Jahren arbeite ich
            selbständig als Berater und Trainer. "Lara 47" verbindet psychologische Spannung mit
            Figuren, deren Entscheidungen Folgen haben.
          </p>
          <p>Band 2 spielt vor dem ersten und entsteht gerade.</p>
          <div class="social-links">
            <a href={instagramUrl} {...externalProps}>Instagram @a_tti_la <span aria-hidden="true">↗</span></a>
            <a href="mailto:attila@krick.me">attila@krick.me</a>
          </div>
        </div>
        <figure class="author-portrait">
          <Image
            src={authorPortrait}
            alt="Schwarzweißporträt von Attila Krick"
            widths={[480, 720, 1024]}
            sizes="(max-width: 800px) 82vw, 42vw"
            format="avif"
            quality={78}
          />
          <figcaption><span>Attila Krick</span><span>Autor · Songtexter</span></figcaption>
        </figure>
      </section>

      <section class="final-cta" aria-labelledby="cta-title">
        <span class="cta-number" aria-hidden="true">47</span>
        <div>
          <p class="overline">Zwischen Kontrolle und Hingabe</p>
          <h2 id="cta-title">Laras Geschichte beginnt dort, wo andere längst über sie entschieden haben.</h2>
          <a class="button button-primary" href={amazonUrl} {...externalProps}>
            Lara 47 bei Amazon ansehen <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    </main>

    <footer id="impressum">
      <div class="footer-heading">
        <span class="wordmark"><span>Lara</span><strong>47</strong></span>
        <p>Ein Roman von Attila Krick</p>
      </div>
      <div class="legal-grid">
        <section aria-labelledby="legal-title">
          <h2 id="legal-title">Impressum</h2>
          <p>Angaben gemäß § 5 DDG</p>
          <address>
            Attila Krick<br />
            An der Schanz 20<br />
            47929 Grefrath<br />
            Deutschland
          </address>
          <p>E-Mail: <a href="mailto:attila@krick.me">attila@krick.me</a></p>
          <p>Verantwortlich für den Inhalt gemäß § 18 Abs. 2 MStV: Attila Krick, Anschrift wie oben.</p>
          <form class="contact-form" action="/api/contact" method="post" id="kontakt">
            <h3>Kontaktformular</h3>
            <p>Du kannst mir auch direkt über dieses Formular schreiben.</p>
            <div class="form-field">
              <label for="contact-name">Name</label>
              <input id="contact-name" name="name" type="text" autocomplete="name" maxlength="100" required />
            </div>
            <div class="form-field">
              <label for="contact-email">E-Mail-Adresse</label>
              <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required />
            </div>
            <div class="form-field">
              <label for="contact-message">Nachricht</label>
              <textarea id="contact-message" name="message" rows="6" maxlength="5000" required></textarea>
            </div>
            <div class="form-trap" aria-hidden="true">
              <label for="contact-website">Website</label>
              <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <label class="form-consent">
              <input name="privacy" type="checkbox" value="accepted" required />
              <span>Ich habe die Datenschutzhinweise zur Kontaktaufnahme gelesen.</span>
            </label>
            <button class="button button-primary" type="submit">Nachricht senden</button>
            <p class="form-status form-success" id="kontakt-versendet" role="status">Deine Nachricht wurde versendet.</p>
            <p class="form-status form-error" id="kontakt-fehler" role="alert">Die Nachricht konnte nicht versendet werden. Schreib bitte direkt an <a href="mailto:attila@krick.me">attila@krick.me</a>.</p>
          </form>
        </section>
        <section aria-labelledby="privacy-title">
          <h2 id="privacy-title">Datenschutz</h2>
          <p>
            Diese Website setzt keine Cookies und verwendet keine Analyse- oder Trackingdienste.
            Inhalte von Amazon, Spotify, YouTube und Instagram werden nicht automatisch geladen.
          </p>
          <p>
            Verantwortlich für die Datenverarbeitung ist Attila Krick, Anschrift und E-Mail-Adresse
            stehen im Impressum auf dieser Seite.
          </p>
          <h3>Hosting und Server-Protokolle</h3>
          <p>
            Beim Aufruf verarbeitet Cloudflare, Inc., 101 Townsend St, San Francisco, CA 94107, USA,
            technisch erforderliche Verbindungsdaten. Dazu können IP-Adresse, Zeitpunkt, aufgerufene
            Adresse, übertragene Datenmenge, Browser- und Betriebssystemangaben sowie die zuvor
            besuchte Seite gehören. Die Verarbeitung dient der sicheren und zuverlässigen
            Bereitstellung dieser Website auf Grundlage von Art. 6 Abs. 1 lit. f DSGVO. Das
            berechtigte Interesse liegt im sicheren und störungsfreien Betrieb der Website.
          </p>
          <p>
            Cloudflare verarbeitet Daten in meinem Auftrag. Eine Verarbeitung in den USA kann nicht
            ausgeschlossen werden. Cloudflare stützt solche Übermittlungen unter anderem auf das
            EU-US Data Privacy Framework und die Standardvertragsklauseln der EU-Kommission. Weitere
            Angaben enthält das <a href="https://www.cloudflare.com/cloudflare-customer-dpa/" {...externalProps}>Data Processing Addendum von Cloudflare <span aria-hidden="true">↗</span></a>.
          </p>
          <h3>Kontaktaufnahme</h3>
          <p>
            Wenn du per E-Mail oder Kontaktformular schreibst, verarbeite ich deinen Namen, deine
            E-Mail-Adresse, den Inhalt deiner Nachricht und die für den Versand technisch nötigen
            Verbindungsdaten. Die Daten werden verwendet, um deine Anfrage zu beantworten. Je nach
            Inhalt beruht die Verarbeitung auf Art. 6 Abs. 1 lit. b oder lit. f DSGVO. Das berechtigte
            Interesse liegt in der Bearbeitung eingehender Anfragen.
          </p>
          <p>
            Formulardaten werden vom Worker an den Versanddienst Resend der Plus Five Five, Inc. in
            den USA übermittelt und als E-Mail an mich zugestellt. Die Versanddomain nutzt die
            Resend-Region Irland. Resend verarbeitet Versanddaten nach eigenen Angaben im kostenlosen
            Tarif bis zu 30 Tage. Für Übermittlungen in die USA gelten das EU-US Data Privacy
            Framework und ergänzend die Standardvertragsklauseln. Weitere Angaben enthält das
            <a href="https://resend.com/legal/dpa" {...externalProps}>Data Processing Addendum von Resend <span aria-hidden="true">↗</span></a>.
            Ich lösche die bei mir eingegangene Nachricht, sobald die Anfrage abgeschlossen ist und
            keine gesetzlichen Aufbewahrungspflichten oder berechtigten Gründe für eine weitere
            Speicherung bestehen.
          </p>
          <h3>Externe Links</h3>
          <p>
            Erst wenn du einen Link zu Amazon, Spotify, YouTube oder Instagram öffnest, wird eine
            Verbindung zum jeweiligen Anbieter hergestellt. Dort gelten dessen Datenschutzhinweise.
          </p>
          <h3>Deine Rechte</h3>
          <p>
            Du hast im gesetzlichen Rahmen das Recht auf Auskunft, Berichtigung, Löschung,
            Einschränkung der Verarbeitung, Datenübertragbarkeit und Widerspruch. Du kannst dich
            außerdem bei einer Datenschutzaufsichtsbehörde beschweren. Für Nordrhein-Westfalen ist
            dies die Landesbeauftragte für Datenschutz und Informationsfreiheit Nordrhein-Westfalen,
            <a href="https://www.ldi.nrw.de/" {...externalProps}>ldi.nrw.de <span aria-hidden="true">↗</span></a>.
          </p>
        </section>
      </div>
      <div class="footer-bottom">
        <p>© 2026 Attila Krick</p>
        <a href="#top">Nach oben <span aria-hidden="true">↑</span></a>
      </div>
    </footer>

    <script>
      const contactForm = document.querySelector<HTMLFormElement>(".contact-form");

      contactForm?.addEventListener("submit", async (event) => {
        event.preventDefault();

        const submitButton = contactForm.querySelector<HTMLButtonElement>('button[type="submit"]');
        const successStatus = contactForm.querySelector<HTMLElement>(".form-success");
        const errorStatus = contactForm.querySelector<HTMLElement>(".form-error");

        history.replaceState(null, "", `${location.pathname}${location.search}`);
        successStatus?.classList.remove("is-visible");
        errorStatus?.classList.remove("is-visible");
        contactForm.setAttribute("aria-busy", "true");
        if (submitButton) submitButton.disabled = true;

        try {
          const response = await fetch(contactForm.action, {
            method: "POST",
            headers: { Accept: "application/json" },
            body: new FormData(contactForm),
          });
          const result = await response.json() as { sent?: boolean };

          if (!response.ok || !result.sent) throw new Error("Contact request failed");

          contactForm.reset();
          successStatus?.classList.add("is-visible");
        } catch {
          errorStatus?.classList.add("is-visible");
        } finally {
          contactForm.removeAttribute("aria-busy");
          if (submitButton) submitButton.disabled = false;
        }
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --ink: #0b0a08;
    --ink-soft: #12100d;
    --paper: #f0e8da;
    --paper-dim: #b7ad9f;
    --gold: #b89156;
    --gold-light: #d2b77e;
    --gold-dark: #725329;
    --line: rgba(184, 145, 86, 0.28);
    --serif: "Cormorant Garamond", Georgia, serif;
    --sans: "Aptos", "Segoe UI", sans-serif;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 5rem; background: var(--ink); }
  body { margin: 0; overflow-x: clip; color: var(--paper); background: var(--ink); font-family: var(--sans); font-size: 1rem; line-height: 1.7; }
  body::before { content: ""; position: fixed; inset: 0; pointer-events: none; z-index: 20; opacity: .12; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.2'/%3E%3C/svg%3E"); }
  img { display: block; max-width: 100%; height: auto; }
  a, summary { touch-action: manipulation; -webkit-tap-highlight-color: rgba(210, 183, 126, .2); }
  a { color: inherit; }
  a:focus-visible, summary:focus-visible { outline: 2px solid var(--gold-light); outline-offset: 5px; }
  ::selection { color: var(--ink); background: var(--gold-light); }

  .skip-link { position: fixed; top: .75rem; left: .75rem; z-index: 100; padding: .7rem 1rem; color: var(--ink); background: var(--paper); transform: translateY(-160%); }
  .skip-link:focus { transform: translateY(0); }
  .site-header { position: absolute; top: 0; left: 0; z-index: 10; width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: 1.25rem clamp(1rem, 4vw, 4rem); border-bottom: 1px solid rgba(240, 232, 218, .13); }
  .wordmark { display: inline-flex; align-items: baseline; gap: .35em; color: var(--paper); font-family: var(--serif); font-size: 1.45rem; line-height: 1; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
  .wordmark strong { color: var(--gold-light); font-size: 1.1em; font-weight: 400; }
  nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .4rem clamp(.8rem, 2.4vw, 2.2rem); }
  nav a { min-height: 2.75rem; display: inline-flex; align-items: center; color: rgba(240, 232, 218, .78); font-size: .74rem; font-weight: 600; letter-spacing: .14em; text-decoration: none; text-transform: uppercase; }
  nav a:hover { color: var(--gold-light); }

  .hero { position: relative; min-height: min(58rem, 100svh); display: grid; align-items: end; overflow: hidden; isolation: isolate; }
  .hero-image { position: absolute; inset: 0; z-index: -3; width: 100%; height: 100%; object-fit: cover; object-position: 64% center; }
  .hero-scrim { position: absolute; inset: 0; z-index: -2; background: linear-gradient(90deg, rgba(5, 5, 4, .98) 0%, rgba(5, 5, 4, .88) 29%, rgba(5, 5, 4, .25) 65%, rgba(5, 5, 4, .42) 100%), linear-gradient(0deg, var(--ink) 0%, transparent 34%); }
  .hero-copy { width: min(46rem, 100%); padding: 9rem clamp(1.25rem, 7vw, 7.5rem) clamp(5rem, 10vh, 8rem); }
  .eyebrow { display: flex; flex-wrap: wrap; gap: .75rem 1.4rem; margin: 0 0 1.6rem; color: var(--gold-light); font-size: .7rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  .eyebrow span { display: inline-flex; align-items: center; gap: 1rem; }
  .eyebrow span:not(:last-child)::after { content: ""; width: 2.5rem; height: 1px; background: var(--line); }
  h1, h2 { font-family: var(--serif); font-weight: 400; text-wrap: balance; }
  h1 { margin: 0; font-size: clamp(5.3rem, 13vw, 11.5rem); line-height: .68; letter-spacing: -.045em; text-transform: uppercase; }
  h1 em { color: var(--gold-light); font-style: normal; font-weight: 400; }
  .subtitle { margin: 1.8rem 0 0; font-family: var(--serif); font-size: clamp(1.4rem, 3vw, 2.15rem); font-style: italic; letter-spacing: .05em; }
